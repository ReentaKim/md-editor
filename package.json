{
  "name": "md-editor",
  "productName": "MD Editor",
  "version": "0.5.0",
  "description": "로컬 설치형 마크다운 편집기 (Mac · Windows / 탭 · 실시간 미리보기 · PDF/HTML 내보내기)",
  "main": "src/main/main.js",
  "author": "ReentaKim <reenta.kim@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --mac --arm64 && node scripts/clean-unpacked.mjs",
    "dist:win": "node build.mjs && electron-builder --win --x64 --publish never && node scripts/clean-unpacked.mjs"
  },
  "build": {
    "appId": "io.github.reentakim.mdeditor",
    "productName": "MD Editor",
    "files": [
      "src/main/**",
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release/${version}",
      "buildResources": "build"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown",
        "role": "Editor",
        "rank": "Default"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MD-Editor-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MD Editor",
      "uninstallDisplayName": "MD Editor",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@vscode/markdown-it-katex": "^1.1.2",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-cjk-friendly": "^3.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ReentaKim/md-editor.git"
  }
}
